{
  "review": {
    "id_pattern": "F\\d+-[A-Z]+-\\d+",
    "max_changed_lines": 400,
    "max_file_lines": 600,
    "max_line_length": 160,
    "source_globs": [
      "skill/rontgen/scripts/*.py"
    ],
    "exclude_globs": [
      "**/*.min.js",
      "**/migrations/**"
    ],
    "critical_globs": [],
    "exempt_message_pattern": "^(release|docs):",
    "baseline": "review-baseline.json"
  }
}